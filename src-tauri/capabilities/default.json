{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. Keep this list minimal (ARCHITECTURE §2.1).",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-settings",
    "allow-save-settings",
    "allow-apply-window-theme",
    "allow-app-ready"
  ]
}
