    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-settings",
    "allow-save-settings",
    "allow-apply-window-theme",
    "allow-app-ready",
    "allow-confirm-quit",
    "allow-workspace-open-last",
    "allow-workspace-choose",
    "allow-workspace-create-default",
    "allow-workspace-info",
    "allow-workspace-reveal",
    "allow-list-children",
    "allow-list-favorites",
    "allow-get-page",
    "allow-create-page",
    "allow-save-page",
    "allow-save-page-over-conflict",
    "allow-set-title",
    "allow-set-icon",
    "allow-move-page",
    "allow-duplicate-page",
    "allow-trash-page",
    "allow-list-trash",
    "allow-restore-trash",
    "allow-delete-trash-entry",
    "allow-set-favorite",
    "allow-import-attachment",
    "allow-write-recovery",
    "allow-list-recovery",
    "allow-discard-recovery",
